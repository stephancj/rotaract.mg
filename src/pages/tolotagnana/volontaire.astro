---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { clubs } from '../../data/clubs';
const rotaractMadagasikaraLogo = 'https://rotaplast.rotary.mg/assets/rotaract-madagasikara-logo.png';

const apiBase = (import.meta.env.PUBLIC_TOLOTANANA_API_URL || 'http://127.0.0.1:3000').replace(/\/$/, '');
const steps = ['Profil', 'Disponibilité', 'Expérience', 'Compétences', 'Motivation', 'Validation'];
const rotaractClubs = [...clubs].sort((a, b) => a.name.localeCompare(b.name, 'fr')).map((club) => club.name);
const rotaryClubs = ['Rotary Antananarivo', 'Rotary Antananarivo-Ainga', 'Rotary Antananarivo Ambohitsorohitra', 'Rotary Antananarivo Ankorondrano', 'Rotary Antananarivo-Anosy', 'Rotary Antananarivo-Ivandry', 'Rotary Antananarivo-Mahamasina', 'Rotary Antananarivo Maroloko', 'Rotary Antananarivo-Tsimbaroa', 'Rotary Antananarivo-Vovonana', 'Rotary Fianarantsoa', 'Rotary Ivato', 'Rotary Lac Alaotra', 'Rotary Mahajanga', 'Rotary Manakara', 'Rotary Morondava Baobab', 'Rotary Nosy Be', 'Rotary Tamatave', 'Rotary Toliara'];
const skills = [
  ['organisation', 'Organisation', 'Planning et coordination'], ['relation-patient', 'Relation patient', 'Accueil et écoute'],
  ['premiers-secours', 'Premiers secours', 'Formation ou pratique'], ['photo-video', 'Photo & vidéo', 'Prise de vue et montage'],
  ['reseaux-sociaux', 'Réseaux sociaux', 'Contenu et publication'], ['traduction', 'Traduction', 'Malgache, français ou autre'],
  ['conduite', 'Conduite', 'Permis et disponibilité'], ['cuisine', 'Cuisine', 'Préparation et service'],
];
const roles = [['accueil', 'Accueil'], ['enregistrement', 'Enregistrement'], ['logistique', 'Logistique'], ['interpretariat', 'Interprétariat'], ['restauration', 'Restauration'], ['communication', 'Communication']];
const commissions = [
  ['logistique', 'Logistique', 'Ressources, transports et organisation.', "La commission Logistique est responsable de la coordination des ressources, de la gestion des fournitures médicales, du transport, de l’hébergement, et de l’organisation générale de la mission. Les bénévoles de cette commission contribuent à assurer une logistique efficace pendant la mission."],
  ['communication', 'Communication', 'Information, contenus et médias sociaux.', "La commission Communication s’occupe de la diffusion d’informations sur la mission, de la sensibilisation du public, de la création de contenu (photos, vidéos, articles) et de la gestion des médias sociaux. Les bénévoles de cette commission contribuent à faire connaître notre mission et à mobiliser un soutien."],
  ['technique', 'Technique', 'Patients et coordination médicale.', "La commission Technique s’adresse aux personnes ayant un contact avec les malades et le personnels de la santé. Elle est responsable de la planification et de la réalisation des interventions chirurgicales et des soins médicaux. Les bénévoles de cette commission travaillent directement avec les patients."],
  ['finance', 'Finance', 'Budget, achats et suivi financier.', "La commission Finance gère le budget de la mission, l’achat, la collecte de fonds, la comptabilité, et la recherche de partenaires financiers. Les bénévoles de cette commission contribuent à assurer la viabilité financière de la mission."],
  ['sponsoring', 'Sponsoring', 'Partenaires, dons et financements.', "La commission Sponsoring est chargée de rechercher des sponsors et des partenaires pour soutenir la mission. Cela peut inclure la recherche de dons en nature, de fournitures médicales, de services, ou de financements. Les bénévoles de cette commission aident à garantir les ressources nécessaires pour la mission."],
  ['hebergement', 'Hébergement', 'Logement et accueil des équipes.', "La commission Hébergement est chargée de gérer toute la logistique liée au logement de l’équipe (médecins, organisateurs, bénévoles) durant la mission. Son rôle principal est de rechercher, réserver et répartir les chambres, afin de garantir à chacun un endroit confortable et sécurisé pour se reposer."],
];
---

<BaseLayout title="Candidature volontaire — Tolo-Tagnana" description="Candidatez comme volontaire pour la prochaine édition de Tolo-Tagnana.">
  <a class="skip" href="#form-step">Aller au formulaire</a>
  <header class="topbar">
    <a class="brand" href="/"><img src={rotaractMadagasikaraLogo} alt="Rotaract Madagasikara" /></a>
    <div class="campaign"><img src="/tolotagnana/logo-tolotagnana.png" alt="Tolo-Tagnana" /></div>
    <a class="close" href="/tolotagnana/" aria-label="Quitter le formulaire">Quitter <span>×</span></a>
  </header>

  <main class="application-shell">
    <div class="mobile-progress"><span data-mobile-step>Étape 1 sur 6</span><strong data-mobile-title>Profil</strong></div>
    <nav class="stepper" aria-label="Progression de la candidature">
      {steps.map((step, index) => <button type="button" class:list={{ active: index === 0 }} data-step-target={index} aria-current={index === 0 ? 'step' : undefined}><span>{index + 1}</span><small>{step}</small></button>)}
      <div class="track"><i data-track></i></div>
    </nav>

    <form data-form data-api-base={apiBase} data-rotaract-clubs={JSON.stringify(rotaractClubs)} data-rotary-clubs={JSON.stringify(rotaryClubs)} novalidate>
      <section class="step active" data-step="0" id="form-step">
        <header><p>ÉTAPE 1 · PROFIL</p><h1>Commençons par vous.</h1><span>Ces informations permettront à l’équipe de vous identifier et de vous recontacter.</span></header>
        <fieldset class="choice-group organization-choice" data-required-choice="organization_type">
          <legend>Vous êtes membre de quel mouvement ? *</legend>
          <div class="binary compact"><label><input type="radio" name="organization_type" value="rotaract" /><span><b>Rotaract</b><small>Club Rotaract du District 9220</small></span></label><label><input type="radio" name="organization_type" value="rotary" /><span><b>Rotary</b><small>Club Rotary du District 9220</small></span></label></div>
          <p class="field-error" data-choice-error hidden>Choisissez Rotary ou Rotaract.</p>
        </fieldset>
        <div class="fields two member-fields" data-member-fields hidden>
          <label><span>Votre club *</span><select name="club_name" required disabled><option value="">Choisissez d’abord Rotary ou Rotaract</option></select><small>Liste issue de l’annuaire du District 9220.</small></label>
          <fieldset class="choice-group status-choice" data-required-choice="club_status"><legend>Statut par rapport au club *</legend><div class="chips"><label><input type="radio" name="club_status" value="membre" /><span>Membre</span></label><label><input type="radio" name="club_status" value="sympathisant" /><span>Sympathisant·e</span></label><label><input type="radio" name="club_status" value="invite" /><span>Invité·e</span></label></div><p class="field-error" data-choice-error hidden>Choisissez votre statut.</p></fieldset>
          <label class="wide" data-other-club hidden><span>Nom du club *</span><input name="other_club_name" maxlength="140" placeholder="Saisissez le nom complet du club" /></label>
          <label><span>Prénom *</span><input name="first_name" autocomplete="given-name" maxlength="80" required /></label>
          <label><span>Nom *</span><input name="last_name" autocomplete="family-name" maxlength="80" required /></label>
          <label><span>Adresse e-mail *</span><input type="email" name="email" autocomplete="email" maxlength="180" required /></label>
          <label><span>Téléphone *</span><input type="tel" name="phone" autocomplete="tel" minlength="6" maxlength="40" placeholder="+261 34 00 000 00" required /></label>
          <label><span>Ville de résidence</span><input name="city" autocomplete="address-level2" maxlength="120" /></label>
          <div class="edition-confirmed wide" data-single-edition hidden><small>VOTRE MISSION</small><strong data-single-edition-title></strong><span data-single-edition-dates></span></div>
          <label class="wide" data-edition-field><span>Édition souhaitée *</span><select name="edition_public_id" required disabled><option value="">Chargement des éditions…</option></select><small data-edition-message>Connexion avec Tolo-Tagnana…</small></label>
        </div>
      </section>

      <section class="step" data-step="1">
        <header><p>ÉTAPE 2 · DISPONIBILITÉ</p><h1>Quand pouvez-vous être présent·e ?</h1><span>Une disponibilité complète facilite l’organisation, mais les disponibilités partielles sont aussi utiles.</span></header>
        <fieldset class="choice-group" data-required-choice="available_full_mission">
          <legend>Êtes-vous disponible pendant toute la mission ? *</legend>
          <div class="binary">
            <label><input type="radio" name="available_full_mission" value="true" /><span><b>Oui, toute la mission</b><small>Je serai disponible du début à la fin.</small></span></label>
            <label><input type="radio" name="available_full_mission" value="false" /><span><b>Seulement certains jours</b><small>Je vais préciser mes dates.</small></span></label>
          </div>
          <p class="field-error" data-choice-error hidden>Choisissez une disponibilité.</p>
        </fieldset>
        <div class="calendar-wrap" data-calendar-wrap hidden>
          <div class="calendar-head"><div><span>Jours disponibles *</span><strong data-calendar-month>Avril 2027</strong></div><p><i></i> Jour sélectionné</p></div>
          <div class="weekdays" aria-hidden="true"><span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span></div>
          <div class="calendar" data-calendar role="group" aria-label="Sélectionnez vos jours disponibles"></div>
          <p class="field-error" data-date-error hidden>Sélectionnez au moins un jour.</p>
          <div class="selection-summary"><strong data-date-count>0 jour sélectionné</strong><button type="button" data-clear-dates>Effacer</button></div>
        </div>
      </section>

      <section class="step" data-step="2">
        <header><p>ÉTAPE 3 · EXPÉRIENCE</p><h1>Votre engagement jusqu’ici.</h1><span>Il n’est pas nécessaire d’avoir déjà participé. Cela nous aide simplement à constituer des équipes complémentaires.</span></header>
        <fieldset class="choice-group" data-required-choice="has_previous_experience">
          <legend>Avez-vous déjà participé à Tolo-Tagnana ? *</legend>
          <div class="binary compact"><label><input type="radio" name="has_previous_experience" value="true" /><span><b>Oui</b></span></label><label><input type="radio" name="has_previous_experience" value="false" /><span><b>Pas encore</b></span></label></div>
          <p class="field-error" data-choice-error hidden>Choisissez une réponse.</p>
        </fieldset>
        <div class="experience-list" data-experience-area hidden>
          <div class="section-label"><span>Éditions précédentes</span><small>Ajoutez les expériences les plus pertinentes.</small></div>
          <div data-experiences></div>
          <button class="add" type="button" data-add-experience><span>+</span> Ajouter une expérience</button>
        </div>
        <label class="standalone"><span>Autre expérience associative ou événementielle</span><textarea name="engagement_experience" rows="4" maxlength="1000" placeholder="Actions de club, accueil du public, organisation d’événements…"></textarea></label>
      </section>

      <section class="step" data-step="3">
        <header><p>ÉTAPE 4 · COMPÉTENCES</p><h1>Où serez-vous le plus utile ?</h1><span>Choisissez vos atouts et vos préférences. L’affectation finale dépendra des besoins de la mission.</span></header>
        <fieldset class="choice-group" data-required-multiple="preferred_roles"><legend>Rôles préférés *</legend><div class="chips">{roles.map(([value, label]) => <label><input type="checkbox" name="preferred_roles" value={value} /><span>{label}</span></label>)}</div><p class="field-error" data-multiple-error hidden>Choisissez au moins un rôle.</p></fieldset>
        <fieldset class="choice-group"><legend>Vos compétences</legend><div class="skill-grid">{skills.map(([value, label, detail]) => <label><input type="checkbox" name="skills" value={value} /><span><i>✓</i><b>{label}</b><small>{detail}</small></span></label>)}</div><label class="standalone other-skills"><span>Autres compétences</span><input name="other_skills" maxlength="300" placeholder="Ex. graphisme, mécanique, achats, animation, informatique…" /><small>Séparez plusieurs compétences par une virgule.</small></label></fieldset>
        <fieldset class="choice-group"><legend>Commissions souhaitées</legend><p class="commission-intro">Nous avons besoin de bénévoles pour diverses commissions. Veuillez indiquer la commission ou les commissions auxquelles vous aimeriez participer en fonction de vos compétences et intérêts. L’icône d’information permet de lire la description complète.</p><div class="commission-grid">{commissions.map(([value, label, description, details], index) => <article class="commission-card"><label><input type="checkbox" name="preferred_commissions" value={value} /><span><i>{String(index + 1).padStart(2, '0')}</i><b>{label}</b><small>{description}</small><em>✓</em></span></label><details><summary aria-label={`En savoir plus sur la commission ${label}`}><i aria-hidden="true">i</i><span>En savoir plus</span></summary><p>{details}</p></details></article>)}</div></fieldset>
      </section>

      <section class="step" data-step="4">
        <header><p>ÉTAPE 5 · MOTIVATION</p><h1>Ce qui vous anime.</h1><span>Une réponse courte suffit. Soyez concret·ète et personnel·le.</span></header>
        <label class="question"><span>Pourquoi souhaitez-vous participer à cette édition ? *</span><textarea name="motivation" rows="6" minlength="20" maxlength="600" required placeholder="Votre motivation en quelques phrases…"></textarea><small><i data-count-for="motivation">0</i> / 600 caractères</small></label>
        <label class="question"><span>Commentaire <em>(optionnel)</em></span><textarea name="contribution" rows="5" maxlength="500" placeholder="Une précision ou un message pour l’équipe…"></textarea><small><i data-count-for="contribution">0</i> / 500 caractères</small></label>
      </section>

      <section class="step" data-step="5">
        <header><p>ÉTAPE 6 · INFORMATIONS PRATIQUES</p><h1>Une dernière vérification.</h1><span>Ces détails nous aident à préparer la logistique et la sécurité de l’équipe.</span></header>
        <div class="practical">
          <fieldset class="choice-group" data-required-choice="tshirt_size"><legend>Taille de T-shirt *</legend><div class="size-row">{['XS','S','M','L','XL','XXL'].map((size) => <label><input type="radio" name="tshirt_size" value={size} /><span>{size}</span></label>)}</div><p class="field-error" data-choice-error hidden>Choisissez une taille.</p></fieldset>
          <fieldset class="choice-group" data-required-choice="dietary_preference"><legend>Préférence alimentaire *</legend><div class="chips"><label><input type="radio" name="dietary_preference" value="aucune" /><span>Aucune restriction</span></label><label><input type="radio" name="dietary_preference" value="sans-porc" /><span>Sans porc</span></label><label><input type="radio" name="dietary_preference" value="vegetarien" /><span>Végétarien</span></label><label><input type="radio" name="dietary_preference" value="vegetalien" /><span>Végétalien</span></label><label><input type="radio" name="dietary_preference" value="halal" /><span>Halal</span></label><label><input type="radio" name="dietary_preference" value="sans-gluten" /><span>Sans gluten</span></label><label><input type="radio" name="dietary_preference" value="sans-lactose" /><span>Sans lactose</span></label><label><input type="radio" name="dietary_preference" value="autre" /><span>Autre</span></label></div><p class="field-error" data-choice-error hidden>Choisissez une préférence.</p><label class="standalone dietary-detail" data-dietary-detail hidden><span>Précisez votre préférence *</span><input name="dietary_details" maxlength="180" placeholder="Décrivez brièvement votre besoin alimentaire" /></label></fieldset>
          <div class="fields two emergency"><label><span>Contact d’urgence *</span><input name="emergency_contact_name" maxlength="160" placeholder="Nom et relation" required /></label><label><span>Téléphone du contact *</span><input type="tel" name="emergency_contact_phone" minlength="6" maxlength="40" placeholder="+261…" required /></label></div>
        </div>
        <div class="review"><div class="review-title"><div><p>RÉCAPITULATIF</p><h2>Votre candidature</h2></div><span>Sauvegardée automatiquement</span></div><div class="review-grid" data-review></div></div>
        <label class="consent"><input type="checkbox" name="consent" required /><span>J’accepte que mes informations soient utilisées par l’équipe Tolo-Tagnana pour traiter ma candidature et me contacter. *</span></label>
        <label class="honeypot" aria-hidden="true">Site web<input name="website" tabindex="-1" autocomplete="off" /></label>
      </section>

      <div class="status" data-status role="alert" hidden></div>
      <footer class="actions"><button class="back" type="button" data-back disabled>Retour</button><div class="save-state"><span><i>✓</i> <span data-save-state>Brouillon sauvegardé</span></span><button type="button" data-reset>Recommencer</button></div><button class="next" type="button" data-next><span>Continuer</span><b>→</b></button><button class="submit" type="submit" data-submit hidden><span>Envoyer ma candidature</span><b>→</b></button></footer>
    </form>

    <section class="success" data-success hidden tabindex="-1"><div class="check">✓</div><p>CANDIDATURE ENREGISTRÉE</p><h1>Misaotra.</h1><span data-success-message>Votre candidature a bien été transmise. L’équipe Tolo-Tagnana vous contactera après étude des besoins de la mission.</span><a href="/tolotagnana/">Retour au programme <b>→</b></a></section>
  </main>

  <script>
    type Edition = { public_id:string; name:string; place:string; year:number; start_date:string|null; end_date:string|null };
    type Draft = Record<string, unknown> & { available_dates?: string[]; previous_editions?: {year:string;place:string;role:string}[]; current_step?: number };
    const form = document.querySelector<HTMLFormElement>('[data-form]');
    if (form) {
      const apiBase = form.dataset.apiBase || '';
      const draftKey = 'tolotagnana-volunteer-draft-v2';
      const sections = [...form.querySelectorAll<HTMLElement>('[data-step]')];
      const stepButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-step-target]')];
      const select = form.elements.namedItem('edition_public_id') as HTMLSelectElement;
      const clubSelect = form.elements.namedItem('club_name') as HTMLSelectElement;
      const editionField = form.querySelector<HTMLElement>('[data-edition-field]')!;
      const singleEdition = form.querySelector<HTMLElement>('[data-single-edition]')!;
      const memberFields = form.querySelector<HTMLElement>('[data-member-fields]')!;
      const otherClubField = form.querySelector<HTMLElement>('[data-other-club]')!;
      const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
      const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
      const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      const status = form.querySelector<HTMLElement>('[data-status]')!;
      const calendarWrap = form.querySelector<HTMLElement>('[data-calendar-wrap]')!;
      const calendar = form.querySelector<HTMLElement>('[data-calendar]')!;
      const experienceArea = form.querySelector<HTMLElement>('[data-experience-area]')!;
      const experiences = form.querySelector<HTMLElement>('[data-experiences]')!;
      const dietaryDetail = form.querySelector<HTMLElement>('[data-dietary-detail]')!;
      let current = 0;
      let editions: Edition[] = [];
      let selectedDates = new Set<string>();

      const readDraft = (): Draft => { try { return JSON.parse(localStorage.getItem(draftKey) || '{}'); } catch { return {}; } };
      const checkedValues = (name:string) => [...form.querySelectorAll<HTMLInputElement>(`[name="${name}"]:checked`)].map((el) => el.value);
      const fieldValue = (name:string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value || '';
      const pretty = (value:string) => value ? value.charAt(0).toUpperCase() + value.slice(1).replaceAll('-', ' ') : 'Non renseigné';

      const populateClubOptions = (type:string, selected = '') => {
        const clubs = JSON.parse(type === 'rotary' ? form.dataset.rotaryClubs || '[]' : form.dataset.rotaractClubs || '[]') as string[];
        clubSelect.innerHTML = '<option value="">Choisir votre club</option>';
        clubs.forEach((club) => { const option = document.createElement('option'); option.value = club; option.textContent = club; clubSelect.append(option); });
        const other = document.createElement('option'); other.value = '__other__'; other.textContent = 'Autre club non listé'; clubSelect.append(other);
        clubSelect.disabled = false; clubSelect.value = selected; memberFields.hidden = false; updateClubOther();
      };

      const updateClubOther = () => { const custom = clubSelect.value === '__other__'; otherClubField.hidden = !custom; const input = otherClubField.querySelector<HTMLInputElement>('input')!; input.required = custom; };

      const serialize = (): Draft => {
        const data = Object.fromEntries(new FormData(form).entries()) as Draft;
        ['preferred_roles','skills','preferred_commissions'].forEach((name) => data[name] = checkedValues(name));
        data.available_full_mission = fieldValue('available_full_mission') === 'true';
        data.available_dates = [...selectedDates];
        data.has_previous_experience = fieldValue('has_previous_experience') === 'true';
        data.previous_editions = [...experiences.querySelectorAll<HTMLElement>('[data-experience]')].map((row) => ({ year:(row.querySelector('[name="experience_year"]') as HTMLInputElement).value, place:(row.querySelector('[name="experience_place"]') as HTMLInputElement).value, role:(row.querySelector('[name="experience_role"]') as HTMLInputElement).value })).filter((item) => item.year || item.place || item.role);
        data.club_selection = fieldValue('club_name');
        data.club_name = fieldValue('club_name') === '__other__' ? fieldValue('other_club_name') : fieldValue('club_name');
        data.current_step = current;
        data.consent = (form.elements.namedItem('consent') as HTMLInputElement).checked;
        return data;
      };
      let saveTimer:number;
      const save = () => { window.clearTimeout(saveTimer); const label = form.querySelector<HTMLElement>('[data-save-state]')!; label.textContent = 'Sauvegarde…'; saveTimer = window.setTimeout(() => { localStorage.setItem(draftKey, JSON.stringify(serialize())); label.textContent = 'Brouillon sauvegardé'; }, 250); };

      const addExperience = (value: {year?:string;place?:string;role?:string} = {}) => {
        const row = document.createElement('div'); row.className = 'experience'; row.dataset.experience = '';
        row.innerHTML = '<label><span>Année</span><input name="experience_year" inputmode="numeric" maxlength="4" placeholder="2025"></label><label><span>Lieu</span><input name="experience_place" maxlength="100" placeholder="Ambatondrazaka"></label><label><span>Rôle</span><input name="experience_role" maxlength="100" placeholder="Accueil"></label><button type="button" aria-label="Supprimer cette expérience">×</button>';
        (row.querySelector('[name="experience_year"]') as HTMLInputElement).value = value.year || '';
        (row.querySelector('[name="experience_place"]') as HTMLInputElement).value = value.place || '';
        (row.querySelector('[name="experience_role"]') as HTMLInputElement).value = value.role || '';
        row.querySelector('button')!.addEventListener('click', () => { row.remove(); if (!experiences.children.length) addExperience(); save(); });
        row.querySelectorAll('input').forEach((input) => input.addEventListener('input', save)); experiences.append(row);
      };

      const renderCalendar = () => {
        const edition = editions.find((item) => item.public_id === select.value);
        let start = edition?.start_date ? new Date(`${edition.start_date}T12:00:00`) : new Date('2027-04-16T12:00:00');
        let end = edition?.end_date ? new Date(`${edition.end_date}T12:00:00`) : new Date('2027-04-25T12:00:00');
        if ((end.getTime() - start.getTime()) / 86400000 > 45) end = new Date(start.getTime() + 9 * 86400000);
        const formatter = new Intl.DateTimeFormat('fr-FR', { month:'long', year:'numeric' });
        form.querySelector<HTMLElement>('[data-calendar-month]')!.textContent = formatter.format(start).replace(/^./, (c) => c.toUpperCase());
        calendar.innerHTML = '';
        const pad = (start.getDay() + 6) % 7; for (let i=0;i<pad;i++) calendar.append(document.createElement('span'));
        for (let day = new Date(start); day <= end; day = new Date(day.getTime() + 86400000)) {
          const iso = day.toISOString().slice(0,10); const button = document.createElement('button'); button.type = 'button'; button.dataset.date = iso; button.className = selectedDates.has(iso) ? 'selected' : '';
          button.innerHTML = `<small>${day.toLocaleDateString('fr-FR',{weekday:'short'}).replace('.','')}</small><b>${day.getDate()}</b>`;
          button.setAttribute('aria-pressed', String(selectedDates.has(iso))); button.setAttribute('aria-label', day.toLocaleDateString('fr-FR',{dateStyle:'full'}));
          button.addEventListener('click', () => { selectedDates.has(iso) ? selectedDates.delete(iso) : selectedDates.add(iso); renderCalendar(); save(); }); calendar.append(button);
        }
        form.querySelector<HTMLElement>('[data-date-count]')!.textContent = `${selectedDates.size} jour${selectedDates.size > 1 ? 's' : ''} sélectionné${selectedDates.size > 1 ? 's' : ''}`;
      };

      const updateConditional = () => {
