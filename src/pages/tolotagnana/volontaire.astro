        const previous = (draft.previous_editions || []).map((item) => [item.year,item.place,item.role].filter(Boolean).join(' · ')).join('\n');
        const items = [
          { title:'Profil', step:0, rows:[['Identité',`${draft.first_name || ''} ${draft.last_name || ''}`.trim()],['Contact',[draft.email,draft.phone].filter(Boolean).join(' · ')],['Club',`${pretty(String(draft.organization_type || ''))} · ${draft.club_name || 'Non renseigné'} · ${pretty(String(draft.club_status || ''))}`],['Ville',String(draft.city || 'Non renseignée')]] },
