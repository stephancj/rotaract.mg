---
import BaseLayout from '../layouts/BaseLayout.astro';
const rotaractMadagasikaraLogo = 'https://rotaplast.rotary.mg/assets/rotaract-madagasikara-logo.png';

const editions = [
  { year: '2022', city: 'Moramanga', patients: '100', status: 'Réalisée' },
  { year: '2023', city: 'Toliara', patients: '151', status: 'Réalisée' },
  { year: '2024', city: 'Mahajanga', patients: '263', status: 'Réalisée' },
  { year: '2025', city: 'Ambatondrazaka', patients: '277', status: 'Réalisée' },
  { year: '2026', city: 'Morondava', patients: '200', status: 'Réalisée' },
  { year: '2027', city: 'Fort-Dauphin', patients: '≈ 300', status: 'Objectif' },
];

const pathologies = ['Fentes labio-palatines', 'Hernies', 'Lipomes', 'Séquelles de brûlures', 'Chéloïdes'];
const journey = [
  ['01', 'Information et accueil', 'Les équipes locales diffusent l’appel et orientent les familles vers la consultation.'],
  ['02', 'Consultation préopératoire', 'Les médecins évaluent chaque situation. La décision d’opérer reste exclusivement médicale.'],
  ['03', 'Intervention gratuite', 'L’équipe chirurgicale assure l’opération, avec le matériel et les médicaments nécessaires.'],
  ['04', 'Suivi postopératoire', 'Les patients sont accompagnés et suivis avant le départ de l’équipe médicale.'],
];
---

<BaseLayout title="Tolo-Tagnana — Chirurgie gratuite | Rotaract Madagascar" description="Tolo-Tagnana offre des interventions chirurgicales gratuites à Madagascar. Découvrez le programme, ses éditions et le rôle des Rotaractiens.">
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="t-header">
    <div class="brand-lockup">
      <a class="t-brand" href="/" aria-label="Rotaract Madagascar — accueil"><img src={rotaractMadagasikaraLogo} alt="Rotaract Madagasikara" /></a>
      <span class="brand-divider" aria-hidden="true"></span>
      <a class="tolo-brand" href="/tolotagnana/" aria-label="Tolo-Tagnana — accueil"><img src="/tolotagnana/logo-tolotagnana.png" alt="Tolo-Tagnana" /></a>
    </div>
    <nav aria-label="Navigation Tolo-Tagnana"><a href="#programme">Le programme</a><a href="#editions">Les éditions</a><a href="#rotaract">Notre rôle</a><a href="#faq">Questions</a></nav>
    <a class="t-donate" href="https://tolotanana.rotary.mg/don.html" target="_blank" rel="noreferrer">Financer une opération <span>↗</span></a>
  </header>

  <main id="contenu">
    <section class="t-hero">
      <div class="t-hero-copy">
        <a class="back" href="/">← Rotaract Madagascar</a>
        <p class="t-overline">CHIRURGIE GRATUITE · DISTRICT 9220</p>
        <h1>Tendre la main.<br /><em>Changer une vie.</em></h1>
        <p class="t-lead">Depuis 2022, Tolo-Tagnana mobilise médecins, Rotariens et Rotaractiens pour offrir des interventions chirurgicales gratuites aux enfants et adultes qui n’ont pas accès aux soins.</p>
        <div class="t-hero-actions"><a class="t-button primary" href="#programme">Comprendre le programme</a><a class="t-button ghost" href="#rotaract">Devenir volontaire</a></div>
      </div>
      <div class="t-hero-photo"><img src="/tolotagnana/enfant-couverture.jpg" alt="Un enfant accueilli pendant une édition de Tolo-Tagnana" /><div class="edition-badge"><span>PROCHAINE ÉDITION</span><strong>16—25<br />AVRIL 2027</strong><b>FORT-DAUPHIN</b></div></div>
    </section>

    <section class="impact-band" aria-label="Chiffres clés"><div><strong>991</strong><span>patients déjà opérés</span></div><div><strong>5</strong><span>éditions réalisées</span></div><div><strong>≈ 30</strong><span>Rotaractiens mobilisés par édition</span></div><div><strong>≈ 300</strong><span>patients visés en 2027</span></div></section>

    <section class="t-section intro" id="programme">
      <div class="section-label"><span>01</span><p>LE PROGRAMME</p></div>
      <div class="intro-title"><h2>Des soins spécialisés,<br /><em>entièrement gratuits.</em></h2></div>
      <div class="intro-copy"><p class="large-copy">Tolo-Tagnana signifie « tendre la main ». L’action offre une prise en charge chirurgicale à des personnes pour qui le coût ou l’éloignement rendent les soins inaccessibles.</p><p>Le programme concerne notamment les fentes labio-palatines, les hernies, les lipomes, les séquelles de brûlures et les chéloïdes. La consultation est ouverte sans condition de ressources ; l’indication opératoire dépend toujours de l’évaluation de l’équipe médicale.</p><div class="chips">{pathologies.map((item) => <span>{item}</span>)}</div></div>
    </section>

    <section class="care-visual"><div class="care-image"><img src="/tolotagnana/bloc-operatoire.jpg" alt="Équipe médicale au bloc opératoire" loading="lazy" /></div><div class="care-copy"><p class="t-overline">UNE CHAÎNE HUMAINE</p><h2>De l’accueil<br />au <em>suivi.</em></h2><p>La gratuité ne concerne pas seulement le geste chirurgical. L’organisation coordonne l’accueil, la consultation, le matériel, les médicaments et le suivi postopératoire.</p><blockquote>« Ce que nous offrons n’est pas seulement un soin : c’est une possibilité de retrouver sa place dans la vie sociale. »</blockquote></div></section>

    <section class="t-section editions" id="editions">
      <div class="section-label"><span>02</span><p>L’IMPACT DEPUIS 2022</p></div>
      <div class="editions-head"><h2>Cinq années<br /><em>sur le terrain.</em></h2><p>Les nombres 2022–2026 correspondent aux patients opérés. Le chiffre 2027 est un objectif annoncé pour l’édition à venir.</p></div>
      <div class="timeline">{editions.map((edition, index) => <article class:list={{ future: index === editions.length - 1 }}><div class="timeline-top"><span>{edition.year}</span><b>{edition.status}</b></div><h3>{edition.city}</h3><strong>{edition.patients}</strong><p>patients</p></article>)}</div>
      <div class="total"><span>100 + 151 + 263 + 277 + 200</span><strong>991 patients opérés</strong><p>Le millième patient pourrait être accueilli pendant l’édition de Fort-Dauphin.</p></div>
    </section>

    <section class="journey" aria-labelledby="journey-title"><div class="journey-head"><p class="t-overline">LE PARCOURS</p><h2 id="journey-title">Comment se déroule<br />la <em>prise en charge ?</em></h2></div><div class="journey-list">{journey.map(([number, title, text]) => <article><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></section>

    <section class="rotaract t-section" id="rotaract">
      <div class="section-label light"><span>03</span><p>LE POINT DE VUE ROTARACT</p></div>
      <div class="rotaract-grid"><div><img src="/assets/rotaract-logo-white.png" alt="Rotaract" /><h2>Au bloc, mais aussi<br /><em>tout autour.</em></h2><p class="large-copy">Les Rotaractiens rendent possible tout ce qui permet aux soignants de se concentrer sur les patients.</p></div><div class="roles"><article><span>01</span><h3>Accueillir</h3><p>Recevoir les familles, expliquer les étapes et aider à l’enregistrement.</p></article><article><span>02</span><h3>Coordonner</h3><p>Appuyer la logistique, les files de consultation et la circulation des informations.</p></article><article><span>03</span><h3>Accompagner</h3><p>Rassurer les patients et leurs proches avant et après l’intervention.</p></article><article><span>04</span><h3>Mobiliser</h3><p>Faire connaître l’action, chercher des partenaires et collecter les ressources.</p></article></div></div>
      <div class="volunteer-note"><strong>30 Rotaractiens</strong><p>devraient accompagner l’équipe à Fort-Dauphin pour l’accueil, l’enregistrement, la logistique, l’interprétariat et la restauration.</p><a class="volunteer-signup" href="/tolotagnana/volontaire/">S’inscrire comme volontaire <span>→</span></a></div>
    </section>

    <section class="fort" id="fort-dauphin"><figure class="fort-photo"><img src="/tolotagnana/fort-dauphin-libanona.jpg" alt="La plage Libanona et le littoral de Fort-Dauphin" loading="lazy" /><span aria-hidden="true">2027</span><figcaption>Fort-Dauphin, plage Libanona · <a href="https://commons.wikimedia.org/wiki/File:Libanona_Beach_-_Tolagnaro_-_Madagascar.jpg" target="_blank" rel="noreferrer">Thelezifor, CC BY-SA 4.0 ↗</a></figcaption></figure><div class="fort-content"><p class="t-overline">6ᵉ ÉDITION · FORT-DAUPHIN</p><h2>Du 16 au 25<br /><em>avril 2027.</em></h2><div class="fort-grid"><div><b>Objectif</b><strong>≈ 300</strong><span>patients</span></div><p>Une équipe médicale malgache réalisera gratuitement des interventions pour des enfants et des adultes. Les détails de consultation et d’inscription doivent être confirmés auprès de l’organisation.</p></div><div class="t-hero-actions"><a class="t-button primary" href="https://tolotanana.rotary.mg/fort-dauphin.html" target="_blank" rel="noreferrer">Informations officielles ↗</a><a class="t-button dark" href="mailto:operationtolotagnana@gmail.com">Contacter l’équipe</a></div></div></section>

    <section class="t-section faces"><div class="faces-copy"><div class="section-label"><span>04</span><p>POURQUOI CELA COMPTE</p></div><h2>Chaque visage raconte<br />une <em>renaissance.</em></h2><p>Une intervention peut rendre un sourire, faciliter la parole ou l’alimentation et réduire l’exclusion vécue par les patients. Derrière chaque nombre se trouve une personne, une famille et un avenir rendu plus libre.</p></div><img src="/tolotagnana/trois-visages.jpg" alt="Trois enfants accompagnés lors d’éditions précédentes" loading="lazy" /></section>

    <section class="t-section faq" id="faq"><div><p class="t-overline">QUESTIONS UTILES</p><h2>Avant de<br /><em>nous contacter.</em></h2></div><div class="faq-list"><details open><summary>À qui s’adresse Tolo-Tagnana ?<span>+</span></summary><p>Aux enfants et adultes qui n’ont pas accès aux soins chirurgicaux concernés, notamment pour des raisons économiques ou géographiques.</p></details><details><summary>L’opération est-elle vraiment gratuite ?<span>+</span></summary><p>Oui. Le programme annonce une prise en charge gratuite de l’intervention, de l’équipe, du matériel, des médicaments et du suivi organisé pendant la mission.</p></details><details><summary>Une consultation garantit-elle une opération ?<span>+</span></summary><p>Non. La consultation permet à l’équipe médicale d’évaluer la pathologie, les risques et l’indication opératoire. La sécurité du patient reste prioritaire.</p></details><details><summary>Comment participer comme Rotaractien ?<span>+</span></summary><p>Contactez l’équipe Tolo-Tagnana ou votre club Rotaract. Les besoins annoncés concernent notamment l’accueil, la logistique, l’interprétariat, la restauration et la communication.</p></details></div></section>

    <section class="cta"><div><p class="t-overline">TROIS FAÇONS D’AGIR</p><h2>Donner. Venir.<br /><em>Parrainer.</em></h2></div><div class="cta-actions"><a href="https://tolotanana.rotary.mg/don.html" target="_blank" rel="noreferrer"><b>01</b><span>Financer une opération</span><strong>↗</strong></a><a href="/tolotagnana/volontaire/"><b>02</b><span>Devenir volontaire</span><strong>→</strong></a><a href="mailto:operationtolotagnana@gmail.com?subject=Partenariat%20Tolo-Tagnana"><b>03</b><span>Devenir partenaire</span><strong>→</strong></a></div></section>
  </main>

  <footer class="t-footer"><div><img src={rotaractMadagasikaraLogo} alt="Rotaract Madagasikara" /><span>District 9220</span></div><p>Tolo-Tagnana — chirurgie réparatrice gratuite portée par les clubs Rotary et Rotaract de Madagascar.</p><div class="footer-contact"><a href="mailto:operationtolotagnana@gmail.com">operationtolotagnana@gmail.com</a><a href="tel:+261327636782">+261 32 76 367 82</a><a href="tel:+261344961220">+261 34 49 612 20</a></div></footer>
</BaseLayout>

<style is:global>
  :root{--cranberry:#d41367;--azure:#0067c8;--royal:#17458f;--orange:#ff7600;--gold:#f7a81b;--charcoal:#54565a;--paper:#f4f6f8;--white:#fdfcfe;--sky:#b9d9eb}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--charcoal);font-family:'Source Sans 3',Arial,sans-serif;background:var(--white)}.skip{position:fixed;left:16px;top:-80px;z-index:100;background:var(--white);color:var(--royal);padding:12px}.skip:focus{top:16px}.t-header{height:86px;padding:0 5.5%;display:flex;align-items:center;gap:35px;background:var(--white);border-top:6px solid var(--cranberry);border-bottom:1px solid var(--sky);position:relative;z-index:20}.t-brand{display:flex;align-items:center;gap:15px;text-decoration:none;color:var(--royal)}.t-brand img{width:128px;height:auto}.t-brand span{border-left:1px solid #b1b1b1;padding-left:15px;text-transform:uppercase;letter-spacing:.12em;font-size:10px;font-weight:800}.t-header nav{display:flex;gap:25px;margin-left:auto}.t-header nav a{color:var(--charcoal);text-decoration:none;font-weight:700;font-size:14px;padding-block:8px;border-bottom:2px solid transparent}.t-header nav a:hover{color:var(--cranberry);border-color:var(--orange)}.t-donate{background:var(--cranberry);color:var(--white);text-decoration:none;padding:13px 18px;font-weight:800;font-size:14px}.t-donate span{margin-left:15px}.t-hero{min-height:720px;display:grid;grid-template-columns:1.15fr .85fr;background:var(--royal);color:var(--white)}.t-hero-copy{padding:54px 7vw 70px;position:relative}.t-hero-copy:before{content:'';position:absolute;left:0;top:0;width:9px;height:100%;background:var(--azure)}.back{color:var(--sky);text-decoration:none;font-weight:700;font-size:13px}.campaign-signature{margin:38px -7vw 30px;padding:15px 7vw 13px;background:var(--white);border-block:5px solid var(--cranberry);display:flex;align-items:center;gap:24px}.tolo-logo{display:block;width:min(520px,78%);height:auto}.campaign-signature span{max-width:120px;color:var(--royal);font-size:9px;line-height:1.35;letter-spacing:.12em;font-weight:800}.t-overline{font-size:11px;font-weight:800;letter-spacing:.16em;color:var(--gold);margin:0 0 20px}.t-hero h1,.t-section h2,.care-copy h2,.journey h2,.fort h2,.cta h2{font:600 clamp(52px,6vw,82px)/.89 'Barlow Condensed',Arial,sans-serif;letter-spacing:-.035em;margin:0}.t-hero h1 em,.t-section h2 em,.care-copy h2 em,.journey h2 em,.fort h2 em,.cta h2 em{font-style:normal;color:var(--orange)}.t-lead{font-size:19px;line-height:1.5;max-width:650px;margin:29px 0}.t-hero-actions{display:flex;gap:12px;flex-wrap:wrap}.t-button{display:inline-block;text-decoration:none;padding:15px 20px;font-weight:800;font-size:14px}.t-button.primary{background:var(--orange);color:var(--white)}.t-button.ghost{border:1px solid color-mix(in srgb,var(--white) 55%,transparent);color:var(--white)}.t-button.dark{border:1px solid var(--royal);color:var(--royal)}.t-hero-photo{position:relative;min-height:630px;overflow:hidden}.t-hero-photo:before{content:'';position:absolute;z-index:1;inset:0;background:linear-gradient(90deg,var(--royal),transparent 35%)}.t-hero-photo:after{content:'';position:absolute;z-index:2;left:0;top:0;width:7px;height:100%;background:var(--azure)}.t-hero-photo>img{width:100%;height:100%;object-fit:cover;object-position:center 30%;position:absolute;inset:0}.edition-badge{position:absolute;z-index:3;right:0;bottom:0;width:235px;padding:28px;background:var(--cranberry);color:var(--white);border-top:7px solid var(--orange)}.edition-badge span,.edition-badge b{display:block;font-size:10px;letter-spacing:.12em}.edition-badge strong{display:block;font:600 39px/1 'Barlow Condensed',Arial,sans-serif;margin:15px 0}.impact-band{display:grid;grid-template-columns:repeat(3,1fr)}.impact-band div{padding:27px 3.5vw;display:flex;align-items:baseline;gap:12px;color:var(--white)}.impact-band div:nth-child(1){background:var(--cranberry)}.impact-band div:nth-child(2){background:var(--royal)}.impact-band div:nth-child(3){background:var(--gold);color:var(--royal)}.impact-band strong{font:700 39px 'Barlow Condensed',Arial,sans-serif;color:var(--white);white-space:nowrap}.impact-band div:nth-child(3) strong{color:var(--royal)}.impact-band span{font-size:13px;font-weight:700}.t-section{padding:110px 8%;}.section-label{display:flex;gap:14px;align-items:center;color:var(--cranberry);margin-bottom:55px}.section-label span{border:1px solid currentColor;border-radius:50%;width:31px;height:31px;display:grid;place-items:center;font-size:10px;font-weight:800}.section-label p{font-size:11px;font-weight:800;letter-spacing:.15em;margin:0}.intro{display:grid;grid-template-columns:.3fr .85fr .85fr;gap:45px}.intro-title h2{font-size:61px;color:var(--royal)}.intro-title h2 em{color:var(--cranberry)}.large-copy{font-size:21px;line-height:1.45}.intro-copy>p{line-height:1.55}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:30px}.chips span{padding:8px 11px;background:#e9f4fb;color:var(--royal);font-size:12px;font-weight:800}.care-visual{display:grid;grid-template-columns:1fr 1fr;background:var(--paper)}.care-image{min-height:660px;position:relative}.care-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.care-copy{padding:100px 9%;align-self:center}.care-copy h2{color:var(--royal)}.care-copy p:not(.t-overline){font-size:18px;line-height:1.55}.care-copy blockquote{border-top:5px solid var(--cranberry);margin:35px 0 0;padding:22px 0 0;font-size:20px;font-weight:600;line-height:1.4;color:var(--royal)}.editions{background:var(--white)}.editions-head{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;margin-bottom:55px}.editions-head h2{color:var(--royal)}.editions-head h2 em{color:var(--cranberry)}.editions-head p{font-size:17px;line-height:1.5;max-width:480px}.timeline{display:grid;grid-template-columns:repeat(6,1fr);border-top:1px solid #d0cfcd;border-bottom:1px solid #d0cfcd}.timeline article{padding:23px 18px;border-right:1px solid #d0cfcd;min-height:245px}.timeline article:last-chil