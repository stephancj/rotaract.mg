---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubs } from '../data/clubs';

const rotaractMadagasikaraLogo = 'https://rotaplast.rotary.mg/assets/rotaract-madagasikara-logo.png';
const collectiveActions = [
  { category: 'Santé · Programme interclubs', title: 'Tolo-Tagnana', description: 'Une chaîne humaine mobilisée pour rendre des interventions chirurgicales accessibles gratuitement.', meta: '991 patients accompagnés', href: '/tolotagnana/' },
  { category: 'Santé · End Polio Now', title: 'Agir contre la polio', description: 'Vaccination, sensibilisation des familles et Urban Trail réunissent les clubs autour d’un même objectif : en finir avec la poliomyélite.', meta: 'Vaccination · Urban Trail', href: 'https://www.endpolio.org/fr' },
  { category: 'Leadership · District 9220', title: 'RYLA', description: 'Un séminaire commun pour renforcer le leadership, transmettre des compétences et créer des liens entre jeunes engagés du District.', meta: 'Rendez-vous annuel', href: 'https://gouverneurdistrict9220.org/' },
  { category: 'Environnement · Interclubs', title: 'Reboisement', description: 'Des journées communes pour planter des arbres, restaurer les paysages et sensibiliser les communautés à la protection de leur environnement.', meta: 'Mobilisation sur le terrain', href: 'https://www.rotaractamontana.org/actions' },
  { category: 'Environnement · Interclubs', title: 'World Cleanup Day', description: 'Des Rotaractiens réunis au Rova d’Ilafy pour agir ensemble en faveur de leur environnement.', meta: 'Amontana · Tsinjo', href: 'https://www.rotaractamontana.org/actions' },
];
const networkEvents = [
  { cadence: 'Chaque année', title: 'RYLA', scope: 'District 9220', description: 'Le séminaire de leadership qui réunit de jeunes participants autour de la formation, de l’engagement et du réseau.', href: '' },
  { cadence: 'Chaque année', title: 'Urban Trail', scope: 'Madagascar · End Polio Now', description: 'Une marche sportive et solidaire qui rassemble les clubs et le public pour soutenir l’éradication de la poliomyélite.', href: 'https://newsmada.com/2026/06/08/urban-trail-8e-edition-deux-mille-foulees-pour-vaincre-la-poliomyelite/' },
  { cadence: 'Chaque année', title: 'Conférence Rotaract du District', scope: 'District 9220', description: 'Le grand rassemblement des clubs pour partager leur année, se former et vivre un temps fort de camaraderie.', href: '' },
  { cadence: 'Plusieurs fois par an', title: 'Rencontres interclubs', scope: 'Madagascar', description: 'Des formations, échanges et moments de camaraderie organisés ensemble par plusieurs clubs de la Grande Île.', href: '' },
  { cadence: 'Chaque année · Mars', title: 'Semaine mondiale du Rotaract', scope: 'Réseau international', description: 'Une semaine pour célébrer le mouvement, faire connaître ses projets et renforcer les liens entre Rotaract et Rotary.', href: '' },
];
---

<BaseLayout title="Rotaract Madagascar | Agir, apprendre, servir" description="Découvrez les clubs Rotaract de Madagascar, leurs actions et les façons de rejoindre le mouvement dans le District 9220.">
  <a class="skip-link" href="#contenu">Aller au contenu</a>

  <header class="site-header">
    <a class="brand" href="#top" aria-label="Rotaract Madagascar, accueil">
      <img src={rotaractMadagasikaraLogo} alt="Rotaract Madagasikara" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      <span class="sr-only">Ouvrir le menu</span>
    </button>
    <nav id="main-nav" aria-label="Navigation principale">
      <a href="#mission">Découvrir</a>
      <a href="#clubs">Nos clubs</a>
      <a href="#action">Vie du réseau</a>
    </nav>
    <a class="header-cta" href="/contact/">Nous contacter <span aria-hidden="true">→</span></a>
  </header>

  <main id="contenu">
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="context">ROTARACT MADAGASIKARA · DISTRICT 9220</p>
        <h1 aria-label="À Madagascar, nous agissons ensemble.">
          <span aria-hidden="true">À Madagascar,</span><br />
          <span aria-hidden="true">nous <strong class="hero-word" data-hero-word>agissons ensemble.</strong></span>
        </h1>
        <p class="hero-lead">Nous sommes des jeunes adultes de 18 ans et plus, réunis dans des clubs autonomes pour servir nos communautés, développer notre leadership et construire des amitiés qui dépassent les frontières.</p>
        <div class="hero-motto">
          <span>Notre devise</span>
          <strong>La camaraderie par le service.</strong>
        </div>
        <div class="hero-actions">
          <a class="button primary" href="#clubs">Trouver mon club <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#mission">Comprendre le Rotaract <span aria-hidden="true">→</span></a>
        </div>
        <ul class="proof-line" aria-label="Repères du réseau">
          <li><b>{clubs.length}</b> clubs référencés</li>
          <li><b>{new Set(clubs.map((c) => c.city)).size}</b> villes représentées</li>
          <li>District <b>9220</b></li>
        </ul>
      </div>
      <figure class="hero-visual">
        <img src="https://www.rotaractamontana.org/_next/image?q=82&amp;url=https%3A%2F%2Frtc-amontana.pockethost.io%2Fapi%2Ffiles%2Fh0wsjdz57emczo6%2Fskoguofvhtlvklo%2Fwcd_lyuj_qz9_gq_i_kRKxTaI7Ve.jpg&amp;w=1080" alt="Rotaractiens d’Amontana et de Tsinjo réunis pour une action environnementale au Rova d’Ilafy" />
        <figcaption><span>Des clubs en mouvement</span><strong>Agir ensemble, localement.</strong><a href="#clubs">Rencontrer un club →</a></figcaption>
      </figure>
    </section>

    <section class="mission" id="mission">
      <div class="section-intro">
        <p class="section-index">01 · LE MOUVEMENT</p>
        <h2>La camaraderie <br />par <em>le service.</em></h2>
      </div>
      <div class="mission-content">
        <p class="mission-lead">Le Rotaract réunit les personnes de 18 ans et plus autour d’une même dynamique : apprendre par l’action, servir l’intérêt général et avancer avec une communauté ouverte sur le monde.</p>
        <ol class="principles">
          <li><span>01</span><div><h3>Agir dans sa communauté</h3><p>Chaque club choisit et construit des projets adaptés aux réalités de son territoire.</p></div></li>
          <li><span>02</span><div><h3>Grandir par l’expérience</h3><p>Organiser, décider, prendre la parole et développer son leadership sur le terrain.</p></div></li>
          <li><span>03</span><div><h3>Créer des liens</h3><p>Rejoindre une communauté de personnes engagées à Madagascar et dans le monde.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="club-life" id="experience">
      <div class="club-life-heading">
        <span>Ce que l’on vit dans un club</span>
        <h2>Plus qu’un engagement, <strong>une expérience qui transforme.</strong></h2>
      </div>
      <div class="club-life-list">
        <article><b>01</b><h3>Des actions utiles</h3><p>Identifier un besoin, imaginer une réponse et agir concrètement avec les acteurs locaux.</p></article>
        <article><b>02</b><h3>Des compétences réelles</h3><p>Apprendre à piloter un projet, communiquer, mobiliser une équipe et prendre des responsabilités.</p></article>
        <article><b>03</b><h3>Une communauté vivante</h3><p>Partager des rencontres, des événements et des moments de camaraderie au-delà des projets.</p></article>
        <article><b>04</b><h3>Un réseau international</h3><p>Échanger avec les clubs du District 9220 et rejoindre un mouvement présent dans le monde entier.</p></article>
      </div>
    </section>

    <section class="clubs" id="clubs">
      <div class="clubs-heading">
        <div>
          <p class="section-index light">02 · LE RÉSEAU</p>
          <h2>Trouvez votre <br /><em>club Rotaract.</em></h2>
        </div>
        <div class="clubs-guidance">
          <p>Recherchez un club par nom, ville ou quartier. Les lieux et horaires peuvent évoluer : contactez le club avant votre première visite.</p>
          <span>Annuaire Madagascar · District 9220</span>
        </div>
      </div>

      <div class="club-tools">
        <label class="club-search">
          <span class="sr-only">Rechercher un club</span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path></svg>
          <input id="club-search" type="search" placeholder="Nom du club, ville ou quartier" autocomplete="off" />
        </label>
        <label class="city-select"><span>Ville</span><select id="club-city"><option value="all">Toutes les villes</option><option value="Antananarivo">Antananarivo</option><option value="Antsirabe">Antsirabe</option><option value="Mahajanga">Mahajanga</option></select></label>
        <button class="clear-filters" type="button" hidden>Effacer</button>
      </div>

      <p class="club-results" aria-live="polite"><b id="club-count">4</b> <span id="club-count-label">clubs affichés sur {clubs.length}</span></p>
      <div class="club-grid">
        {clubs.map((club, index) => (
          <article class="club-card" data-index={index} data-city={club.city} data-search={`${club.name} ${club.city} ${club.area}`.toLowerCase()}>
            <div class="club-card-head"><span>{String(index + 1).padStart(2, '0')}</span><span>{club.city}</span></div>
            <h3>{club.name}</h3>
            <dl><div><dt>Lieu</dt><dd>{club.area}</dd></div><div><dt>Réunion indicative</dt><dd>{club.meeting}</dd></div></dl>
            <div class="club-links">
              {club.website && <a href={club.website} target="_blank" rel="noreferrer">{club.websiteLabel} <span aria-hidden="true">↗</span></a>}
              {club.email ? <a href={`mailto:${club.email}`}>Écrire au club <span aria-hidden="true">→</span></a> : !club.website && <a href={`/contact/?objet=rejoindre&club=${encodeURIComponent(club.name)}`}>Demander le contact <span aria-hidden="true">→</span></a>}
            </div>
          </article>
        ))}
      </div>
      <p class="no-results" hidden>Aucun club ne correspond à votre recherche. Essayez une autre ville ou effacez le terme saisi.</p>
      <button class="show-all" type="button" aria-expanded="false">Voir les {clubs.length} clubs <span aria-hidden="true">↓</span></button>
    </section>

    <section class="collective" id="action">
      <header class="collective-heading">
        <div><p class="section-index">03 · VIE DU RÉSEAU</p><h2>Actions et événements <br />en commun.</h2></div>
        <p>Au-delà des projets propres à chaque club, les Rotaractiens se mobilisent ensemble sur le terrain et se retrouvent lors des grands temps forts de Madagascar et du District 9220.</p>
      </header>
      <div class="collective-layout">
        <div class="shared-actions">
          <div class="shared-title"><h3>Actions et événements phares</h3><span>5 initiatives</span></div>
          {collectiveActions.map((action, index) => (
            <article class:list={['shared-action', { featured: index === 0 }]}>
              {index === 0 && <img src="/tolotagnana/bloc-operatoire.jpg" alt="Équipe médicale et bénévoles pendant une mission Tolo-Tagnana" loading="lazy" />}
              <div class="shared-action-copy">
                <div class="shared-action-meta"><span>{action.category}</span><span>{action.meta}</span></div>
                <h4>{action.title}</h4><p>{action.description}</p>
                <a href={action.href} target={action.href.startsWith('http') ? '_blank' : undefined} rel={action.href.startsWith('http') ? 'noreferrer' : undefined}>Découvrir <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
        <aside class="network-events" aria-labelledby="events-title">
          <div class="shared-title"><h3 id="events-title">Événements communs</h3><span>5 rendez-vous</span></div>
          <p class="events-intro">Ces rendez-vous reviennent au fil de l’année. Les dates exactes sont annoncées par les clubs et le District.</p>
          {networkEvents.map((event) => (
            <article class="network-event">
              <span class="event-cadence">{event.cadence}</span>
              <div>
                <h4>{event.title}</h4><span class="event-scope">{event.scope}</span><p>{event.description}</p>
                {event.href && <a class="event-link" href={event.href} target="_blank" rel="noreferrer">En savoir plus <span aria-hidden="true">↗</span></a>}
              </div>
            </article>
          ))}
          <a class="events-contact" href="https://tally.so/r/yPQ6lp" target="_blank" rel="noreferrer">Demander le prochain calendrier <span aria-hidden="true">↗</span></a>
        </aside>
      </div>
    </section>

    <section class="participate" id="agir">
      <div class="participate-heading">
        <p class="section-index">04 · PASSER À L’ACTION</p>
        <h2>Choisissez votre <br /><em>prochaine étape.</em></h2>
        <p>Le Rotaract se vit d’abord en club. Choisissez la porte d’entrée qui correspond à votre envie.</p>
      </div>
      <ol class="participation-list">
        <li><span>01</span><div><h3>Rejoindre un club</h3><p>Découvrez le club le plus proche et contactez directement son équipe.</p></div><a href="#clubs">Trouver un club →</a></li>
        <li><span>02</span><div><h3>Participer à une première réunion</h3><p>Venez rencontrer les membres, découvrir le fonctionnement du club et poser vos questions.</p></div><a href="#clubs">Voir les coordonnées →</a></li>
        <li><span>03</span><div><h3>Construire un partenariat</h3><p>Associez votre organisation, votre expertise ou vos moyens à une initiative locale ou nationale.</p></div><a href="https://tally.so/r/yPQ6lp" target="_blank" rel="noreferrer">Proposer un partenariat ↗</a></li>
        <li><span>04</span><div><h3>Contacter la coordination</h3><p>Pour une demande nationale, institutionnelle ou média, utilisez le formulaire de coordination.</p></div><a href="https://tally.so/r/yPQ6lp" target="_blank" rel="noreferrer">Contacter la coordination ↗</a></li>
      </ol>
    </section>

    <section class="faq" id="questions">
      <div class="faq-heading">
        <span>Avant de nous rejoindre</span>
        <h2>Les réponses aux premières questions.</h2>
        <p>Chaque club garde son identité et son fonctionnement. Pour les informations propres à un club, contactez directement son équipe.</p>
      </div>
      <div class="faq-list">
        <details><summary>Qui peut rejoindre le Rotaract ? <span aria-hidden="true">+</span></summary><p>Le Rotaract accueille les adultes de 18 ans et plus qui souhaitent s’engager, apprendre et agir avec d’autres. Aucun parcours particulier n’est imposé.</p></details>
        <details><summary>Faut-il déjà connaître un membre ? <span aria-hidden="true">+</span></summary><p>Non. Vous pouvez contacter le club de votre choix et demander à assister à une première réunion ou à une action ouverte.</p></details>
        <details><summary>Comment choisir son club ? <span aria-hidden="true">+</span></summary><p>Commencez par la proximité, les horaires et les projets qui vous parlent. Une première rencontre permet ensuite de découvrir l’ambiance du club.</p></details>
        <details><summary>Y a-t-il une cotisation ? <span aria-hidden="true">+</span></summary><p>Les modalités d’adhésion et de cotisation sont définies par chaque club. Le club vous les présentera clairement avant votre engagement.</p></details>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-main">
      <div class="footer-identity">
        <a class="footer-brand" href="#top" aria-label="Rotaract Madagascar, retour en haut"><img src={rotaractMadagasikaraLogo} alt="Rotaract Madagasikara" /></a>
        <p>La camaraderie par le service.</p>
        <span>Des clubs de jeunes adultes engagés à Madagascar, au sein du District 9220.</span>
      </div>
      <nav class="footer-nav" aria-label="Navigation de pied de page">
        <h2>Découvrir</h2>
        <a href="#mission">Le mouvement</a>
        <a href="#experience">La vie en club</a>
        <a href="#clubs">Les clubs</a>
        <a href="#action">Vie du réseau</a>
      </nav>
      <div class="footer-links">
        <h2>Le réseau</h2>
        <a href="https://www.rotary.org/fr/get-involved/rotaract-clubs" target="_blank" rel="noreferrer">Rotaract International <span aria-hidden="true">↗</span></a>
        <a href="https://gouverneurdistrict9220.org/" target="_blank" rel="noreferrer">District 9220 <span aria-hidden="true">↗</span></a>
        <a href="/contact/">Nous contacter</a>
      </div>
      <div class="footer-cta">
        <span>Prêt à passer à l’action ?</span>
        <strong>Trouvez le club qui vous ressemble.</strong>
        <a href="#clubs">Voir les clubs <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 Rotaract Madagasikara</p>
      <p>Rotary International · District 9220 · Madagascar</p>
      <a href="#top">Retour en haut <span aria-hidden="true">↑</span></a>
    </div>
  </footer>
</BaseLayout>

<script>
  const heroWord = document.querySelector<HTMLElement>('[data-hero-word]');
  const heroPhrases = ['agissons ensemble.', 'développons nos talents.', 'créons des liens.', 'servons nos communautés.'];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (heroWord && !reduceMotion) {
    let phraseIndex = 0;
    window.setInterval(() => {
      heroWord.classList.add('is-changing');
      window.setTimeout(() => {
        phraseIndex = (phraseIndex + 1) % heroPhrases.length;
        heroWord.textContent = heroPhrases[phraseIndex];
        heroWord.classList.remove('is-changing');
      }, 280);
    }, 3400);
  }

  const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menuLabel = menuButton?.querySelector<HTMLElement>('.sr-only');
  const navigation = document.querySelector<HTMLElement>('#main-nav');
  const closeMenu = () => {
    menuButton?.setAttribute('aria-expanded', 'false');
    if (menuLabel) menuLabel.textContent = 'Ouvrir le menu';
    navigation?.classList.remove('open');
  };
  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    if (menuLabel) menuLabel.textContent = open ? 'Ouvrir le menu' : 'Fermer le menu';
    navigation?.classList.toggle('open', !open);
  });
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
  document.addEventListener('click', (event) => {
    if (!navigation?.classList.contains('open')) return;
    if (event.target instanceof Node && !navigation.contains(event.target) && !menuButton?.contains(event.target)) closeMenu();
  });

  const search = document.querySelector<HTMLInputElement>('#club-search');
  const city = document.querySelector<HTMLSelectElement>('#club-city');
  const cards = [...document.querySelectorAll<HTMLElement>('.club-card')];
  const count = document.querySelector<HTMLElement>('#club-count');
  const countLabel = document.querySelector<HTMLElement>('#club-count-label');
  const empty = document.querySelector<HTMLElement>('.no-results');
  const showAll = document.querySelector<HTMLButtonElement>('.show-all');
  const clearFilters = document.querySelector<HTMLButtonElement>('.clear-filters');
  let expanded = false;

  const updateClubs = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    const selectedCity = city?.value ?? 'all';
    const filtering = Boolean(query || selectedCity !== 'all');
    let matching = 0;
    let visible = 0;

    cards.forEach((card, index) => {
      const matchesCity = selectedCity === 'all' || card.dataset.city === selectedCity;
      const matchesSearch = !query || card.dataset.search?.includes(query);
      const matches = Boolean(matchesCity && matchesSearch);
      if (matches) matching += 1;
      const show = matches && (expanded || filtering || index < 4);
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (count) count.textContent = String(visible);
    if (countLabel) countLabel.textContent = filtering ? `club${visible > 1 ? 's' : ''} trouvé${visible > 1 ? 's' : ''}` : `clubs affichés sur ${cards.length}`;
    if (empty) empty.hidden = matching !== 0;
    if (clearFilters) clearFilters.hidden = !filtering;
    if (showAll) {
      showAll.hidden = filtering;
      showAll.setAttribute('aria-expanded', String(expanded));
      showAll.innerHTML = expanded ? 'Réduire la liste <span aria-hidden="true">↑</span>' : `Voir les ${cards.length} clubs <span aria-hidden="true">↓</span>`;
    }
  };

  search?.addEventListener('input', updateClubs);
  city?.addEventListener('change', updateClubs);
  showAll?.addEventListener('click', () => { expanded = !expanded; updateClubs(); });
  clearFilters?.addEventListener('click', () => {
    if (search) search.value = '';
    if (city) city.value = 'all';
    updateClubs();
    search?.focus();
  });
  updateClubs();
</script>

<style is:global>
  :root {
    --cranberry: #d41367;
    --cranberry-dark: #d41367;
    --blue: #17458f;
    --blue-dark: #17458f;
    --azure: #0067c8;
    --gold: #f7a81b;
    --powder-blue: #b9d9eb;
    --ink: #54565a;
    --muted: #657f99;
    --line: #d0cfcd;
    --paper: #ffffff;
    --white: #ffffff;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: 'Open Sans', Arial, sans-serif; }
  a, button, input, select { font: inherit; }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .skip-link { position: fixed; z-index: 100; top: -5rem; left: 1rem; padding: .8rem 1rem; background: var(--white); color: var(--blue-dark); font-weight: 800; }
  .skip-link:focus { top: 1rem; }
  [hidden] { display: none !important; }

  .site-header { position: relative; z-index: 20; display: grid; grid-template-columns: auto 1fr auto; align-items: center; min-height: 5.5rem; padding: .85rem clamp(1.25rem, 6vw, 6.5rem); background: var(--white); border-top: .38rem solid var(--cranberry); border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; align-items: center; width: max-content; }
  .brand img { display: block; width: auto; height: 3.25rem; }
  .site-header nav { display: flex; justify-content: flex-end; gap: clamp(1.25rem, 2.5vw, 2.5rem); margin-left: auto; margin-right: clamp(1.25rem, 3vw, 3rem); }
  .site-header nav a { color: var(--ink); text-decoration: none; font-size: .9rem; font-weight: 700; }
  .site-header nav a:hover { color: var(--cranberry); }
  .header-cta, .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 2rem; min-height: 3rem; padding: .8rem 1.05rem; text-decoration: none; font-weight: 800; transition: transform 180ms cubic-bezier(.22,1,.36,1), background 180ms ease; }
  .header-cta { background: var(--cranberry); color: var(--white); }
  .header-cta:hover { background: var(--blue); transform: translateY(-2px); }
  .menu-toggle { display: none; border: 0; background: transparent; padding: .65rem; cursor: pointer; }
  .menu-toggle > span:not(.sr-only) { display: block; width: 1.45rem; height: 2px; margin: .26rem; background: var(--blue-dark); }

